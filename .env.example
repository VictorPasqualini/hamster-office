# Copie para .env (docker compose lê .env automaticamente)

# Banco — usuário da aplicação (sujeito a RLS)
DATABASE_URL=postgresql+asyncpg://app_rw:app_pw@db:5432/hamster
# Banco — superusuário, usado apenas pelo bootstrap (migrate)
DATABASE_SUPERUSER_URL=postgresql+asyncpg://postgres:postgres@db:5432/hamster
APP_DB_USER=app_rw
APP_DB_PASSWORD=app_pw

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hamster
MINIO_SECURE=false
# Endpoint público para URLs assinadas acessadas pelo browser (host)
MINIO_PUBLIC_ENDPOINT=localhost:9000

# IA
OLLAMA_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3:8b
EMBED_DIM=1024
# true = exige Ollama; false = cai para respostas/embeddings mock se indisponível
OLLAMA_REQUIRED=false

# Auth
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=14

# App
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
SEED_DEMO=true
