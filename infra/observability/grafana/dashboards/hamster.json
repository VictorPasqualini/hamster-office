{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "Hamster Office — Overview",
  "tags": ["hamster"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requisições HTTP por segundo (por status)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latência HTTP p95 (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Execuções de agentes (total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(agent_runs_total)", "legendFormat": "runs" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tokens consumidos",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(agent_tokens_total)", "legendFormat": "tokens" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Custo acumulado (USD)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(agent_cost_usd_total)", "legendFormat": "custo" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Documentos indexados",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(documents_indexed_total)", "legendFormat": "docs" }
      ]
    }
  ]
}
